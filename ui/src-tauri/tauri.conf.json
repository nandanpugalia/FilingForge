{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FilingForge",
  "version": "0.1.10",
  "identifier": "com.filingforge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FilingForge",
        "width": 980,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/filingforge-api"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyQjdDRTkzQ0Q4MjdFMDcKUldRSGZvTE5rODYzZ3FEbEcrZzBRTmgzNVlYV2huTnpGeDVjckdKTU8vc3poaEpOdWpVT1FCeksK",
      "endpoints": [
        "https://github.com/nandanpugalia/FilingForge/releases/latest/download/latest.json"
      ]
    }
  }
}
